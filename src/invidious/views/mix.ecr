<% content_for "header" do %>
<title><%= HTML.escape(mix.title) %> - Invidious</title>
<% end %>

<div class="pure-g h-box">
    <div class="pure-u-2-3">
        <h3><%= HTML.escape(mix.title) %></h3>
    </div>
    <div class="pure-u-1-3">
        <h3 style="text-align:right">
            <a title="<%= I18n.translate(locale, "generic_button_rss") %>" aria-label="<%= I18n.translate(locale, "generic_button_rss") %>" href="/feed/playlist/<%= mix.id %>"><i aria-hidden="true" class="icon ion-logo-rss"></i></a>
        </h3>
    </div>
</div>

<div class="pure-g">
<% mix.videos.each do |item| %>
    <%= rendered "components/item" %>
<% end %>
</div>
